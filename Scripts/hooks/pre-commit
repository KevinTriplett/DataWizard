#!/usr/bin/env bash
#
# DataWizard commit guard (pre-commit hook)
# ------------------------------------------
# Blocks a commit when the staged changes contain any of:
#   1. unresolved merge-conflict markers (outside fenced code blocks),
#   2. Windows-unsafe filenames, or
#   3. secret-class files (DW-S419): Telegram .session files, .env files,
#      Scripts/output/, Vault Config.md - the list DW Save guards.
#
# The conflict-marker check skips .obsidian/ trees (Obsidian workspace/plugin
# state, not authored content; plugin JS legitimately contains marker strings).
#
# It runs on EVERY commit through git's plumbing -- including unattended
# commits from the Obsidian Git plugin timer and the launchd sync script --
# so silent auto-sync corruption never lands.
#
# Because a blocked auto-commit is otherwise invisible, on a block this hook
# writes SYNC-BLOCKED.md at the repo root (visible in Obsidian) explaining
# what happened and how to fix it. The note clears itself on the next good save.
#
# Installed per-clone by install-git-hooks.sh (.git/hooks/ is not synced).
# Bypass a genuine false positive of checks 1 and 2 once with:
#   git commit --no-verify
# The secret-file check (3) offers no bypass: the fix is to take the file out
# of the commit (git rm --cached), never to skip the check.
#
# Secret-file check scope: the STAGED INDEX only - the files this commit would
# add or change (a staged deletion never blocks; a rename counts as an add of
# the new name; an unborn branch works). Out of scope: `git commit --no-verify`,
# and commits made where hooks do not run (e.g. Obsidian Git on mobile). A
# secret already sitting in a local commit is caught at push time by DW Save's
# secret_guard (datawizard-sync.sh), not here. The pattern list is a verbatim
# copy of is_secret_path from datawizard-sync.sh (the owner); a drift test in
# test_secret_guard.sh fails when the two copies differ. Edit the owner, then
# copy the marked span here - never edit it here alone.
#
# A bare '=======' is ALSO a valid markdown setext heading underline, so it is
# only treated as a conflict marker when the same file also contains '<<<<<<<'.
# A real conflict always has the opening marker; a setext heading never does.
#
# NOTE: the conflict-marker awk grammar below is kept in sync with
# ci/check-conflict-markers.yml -- one grammar, two surfaces. Edit both together.

set -uo pipefail

repo_root="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
breadcrumb="$repo_root/SYNC-BLOCKED.md"

conflict_hits=""
filename_hits=""
secret_hits=""
secret_err=""

# is_secret_path PATH -> 0 when PATH is a secret-class file (see header).
# >>> is_secret_path - verbatim copy, owner: datawizard-sync.sh >>>
is_secret_path() {
  local p="$1" b hit=1 had=0
  b="${p##*/}"
  shopt -q nocasematch && had=1
  shopt -s nocasematch
  case "$b" in
    # Telegram (Telethon) session files and their SQLite journals
    *.session|*.session-journal) hit=0 ;;
    # .env and .env.<anything>, except shareable templates
    .env) hit=0 ;;
    .env.*)
      case "$b" in *.example|*.sample|*.template) ;; *) hit=0 ;; esac ;;
    # operator-specific config, including rollback copies of it
    'Vault Config.md'|'Vault Config.md.'*) hit=0 ;;
  esac
  # harvester output: an output/ folder directly under a Scripts/ folder
  case "/$p" in */Scripts/output/*) hit=0 ;; esac
  [ "$had" -eq 1 ] || shopt -u nocasematch
  return $hit
}
# <<< is_secret_path <<<

# ---- Check 1: unresolved conflict markers (skips fenced code blocks) ----
scan_conflicts() {
  git show ":$1" 2>/dev/null | awk -v fname="$1" '
    { sub(/\r$/, ""); s = $0; sub(/^ ? ? ?/, "", s) }
    s ~ /^```/ || s ~ /^~~~/ { infence = !infence; next }
    infence { next }
    s ~ /^<<<<<<</ { print fname ":" FNR ": " $0; hit = 1; sawopen = 1; next }
    s ~ /^>>>>>>>/ || s ~ /^\|\|\|\|\|\|\|/ { print fname ":" FNR ": " $0; hit = 1; next }
    s ~ /^=======$/ { eq[++neq] = fname ":" FNR ": " $0 }
    END {
      if (sawopen && neq) { for (i = 1; i <= neq; i++) print eq[i]; hit = 1 }
      exit (hit ? 1 : 0) }'
}

while IFS= read -r -d '' path; do
  # skip Obsidian workspace/plugin state (machine state, not authored content):
  # plugins' bundled JS legitimately contains conflict-marker strings, which
  # would false-positive on every plugin update. Filename check below still runs.
  case "$path" in .obsidian/*|*/.obsidian/*) continue ;; esac
  # skip binary blobs (numstat reports "-" for added/removed on binary)
  if [ "$(git diff --cached --numstat -- "$path" | cut -f1)" = "-" ]; then
    continue
  fi
  if out="$(scan_conflicts "$path")"; then
    :
  else
    conflict_hits="${conflict_hits}${out}"$'\n'
  fi
done < <(git diff --cached -z --name-only --diff-filter=ACMR)

# ---- Check 2: Windows-unsafe filenames (same rules as check-filenames.yml) ----
while IFS= read -r -d '' path; do
  IFS='/' read -ra parts <<< "$path"
  for comp in "${parts[@]}"; do
    [ -z "$comp" ] && continue
    reasons=""
    case "$comp" in *" ") reasons="trailing space" ;; esac
    case "$comp" in *.) reasons="${reasons:+$reasons, }trailing dot" ;; esac
    case "$comp" in
      *'?'*|*':'*|*'*'*|*'"'*|*'<'*|*'>'*|*'|'*)
        reasons="${reasons:+$reasons, }reserved character" ;;
    esac
    if printf '%s' "$comp" | LC_ALL=C grep -q '[[:cntrl:]]'; then
      reasons="${reasons:+$reasons, }control character"
    fi
    base="${comp%%.*}"
    shopt -s nocasematch
    case "$base" in
      CON|PRN|AUX|NUL|COM[1-9]|LPT[1-9])
        reasons="${reasons:+$reasons, }reserved device name" ;;
    esac
    shopt -u nocasematch
    if [ -n "$reasons" ]; then
      filename_hits="${filename_hits}${path} (${reasons})"$'\n'
    fi
  done
done < <(git diff --cached -z --name-only --diff-filter=ACMR)

# ---- Check 3: secret-class files (staged index only; see header) ----
# --no-renames: a rename shows as delete + add, so the new name is checked.
# --diff-filter=d: deletions never block. Fails closed: if git cannot list
# the staged files (pipefail catches it), the commit is stopped.
scan_secrets() {
  local p
  while IFS= read -r -d '' p; do
    if is_secret_path "$p"; then printf '%s\n' "$p"; fi
  done
  return 0
}
if secret_hits="$(git diff --cached --name-only --no-renames --diff-filter=d -z | scan_secrets)"; then
  [ -n "$secret_hits" ] && secret_hits="${secret_hits}"$'\n'
else
  secret_hits=""
  secret_err="git could not list the staged files"
fi

# ---- Verdict ----
if [ -z "$conflict_hits" ] && [ -z "$filename_hits" ] && [ -z "$secret_hits" ] && [ -z "$secret_err" ]; then
  rm -f "$breadcrumb" 2>/dev/null || true
  exit 0
fi

{
  echo "# SYNC BLOCKED"
  echo
  echo "Your last save was stopped on purpose because a safety check found a"
  echo "problem. Nothing was lost -- your files are all still here. The save"
  echo "(commit) just did not go through yet."
  echo
  echo "Detected: $(date '+%Y-%m-%d %H:%M')"
  echo
  if [ -n "$conflict_hits" ]; then
    echo "## Unresolved conflict markers"
    echo
    echo "These lines look like an unfinished merge. Git leaves markers like"
    echo '<<<<<<<, =======, and >>>>>>> when two versions disagree:'
    echo
    echo '```'
    printf '%s' "$conflict_hits"
    echo '```'
    echo
    echo "Fix: open each file listed above, delete those marker lines, and keep"
    echo "the text you actually want."
    echo
  fi
  if [ -n "$filename_hits" ]; then
    echo "## Windows-unsafe filenames"
    echo
    echo "These names would break a teammate's sync on Windows:"
    echo
    echo '```'
    printf '%s' "$filename_hits"
    echo '```'
    echo
    echo 'Fix: rename them. No trailing space or dot, and avoid  ? : * " < > |'
    echo
  fi
  if [ -n "$secret_hits" ]; then
    echo "## Secret files staged"
    echo
    echo "These files hold logins, keys or private settings. Once committed and"
    echo "pushed they are readable by everyone with access to the repo, and they"
    echo "stay in its history:"
    echo
    echo '```'
    printf '%s' "$secret_hits"
    echo '```'
    echo
    echo "Fix: take each file out of the commit (this keeps the file on your disk):"
    echo
    printf '%s\n' "$secret_hits" | while IFS= read -r p; do
      [ -n "$p" ] && echo "    git rm --cached -- \"$p\""
    done
    echo
    echo "then add its name to .gitignore so it is not staged again, and save again."
    echo "This check has no bypass."
    echo
  fi
  if [ -n "$secret_err" ]; then
    echo "## Secret-file check could not run"
    echo
    echo "The check for secret files failed ($secret_err), so the save was"
    echo "stopped to be safe. Open a terminal in this repo, run git status to see"
    echo "what is wrong, then save again. This check has no bypass."
    echo
  fi
  echo "---"
  echo
  echo "After fixing, just save again (DW Save / commit-and-sync)."
  if [ -z "$secret_hits" ] && [ -z "$secret_err" ]; then
    echo "If you are certain this is a false alarm, bypass the check once with:"
    echo
    echo '    git commit --no-verify'
    echo
  fi
  echo "This note disappears automatically once the next save succeeds."
} > "$breadcrumb"

echo "COMMIT BLOCKED by the DataWizard commit guard." >&2
[ -n "$conflict_hits" ] && echo "  - unresolved conflict markers found in staged files" >&2
[ -n "$filename_hits" ] && echo "  - Windows-unsafe filenames found in staged files" >&2
if [ -n "$secret_hits" ]; then
  echo "  - secret file(s) staged - take each out of the commit (keeps the file on disk):" >&2
  printf '%s\n' "$secret_hits" | while IFS= read -r p; do
    [ -n "$p" ] && echo "      git rm --cached -- \"$p\"" >&2
  done
  echo "    then add it to .gitignore and commit again" >&2
fi
[ -n "$secret_err" ] && echo "  - the secret-file check could not run ($secret_err) - run git status" >&2
echo "  Details written to SYNC-BLOCKED.md (open it in Obsidian)." >&2
if [ -z "$secret_hits" ] && [ -z "$secret_err" ]; then
  echo "  Bypass once (only if you are sure): git commit --no-verify" >&2
fi

exit 1
